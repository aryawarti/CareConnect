<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.careconnect</groupId>
        <artifactId>careconnect-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>platform-starter</artifactId>
    <name>CareConnect Platform Starter</name>
    <description>
        The ONE shared library permitted by ADR-001, and only for cross-cutting
        conventions every service must implement identically: correlation-id
        propagation, and the gateway-trust check that stops any caller other
        than the gateway from asserting an identity. Business code never goes
        here: shared libraries couple release cycles, so this stays
        deliberately tiny.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- Optional: only services that call other services pull OpenFeign in.
             The interceptor bean is @ConditionalOnClass, so identity-service and
             notification-service (no Feign clients) simply don't get it. -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
