# --- PostgreSQL ---
POSTGRES_USER=careconnect
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_PORT=9092

# --- JWT (identity-service) ---
# Generate locally: openssl rand -base64 64
JWT_SECRET=change-me-generate-a-real-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Initial admin account (identity-service seeds it on first start; leave
# password empty to skip seeding) ---
# The clinic administrator. This account hires doctors and configures the
# clinic — without it the system has no way to create anything, so local dev
# defaults to Admin12345 even if you leave this blank.
SEED_ADMIN_EMAIL=admin@careconnect.local
SEED_ADMIN_PASSWORD=Admin12345
