# Copy to .env for LOCAL development:  cp .env.example .env
#
# Everything below configures docker-compose.yml (a laptop). A real deployment
# uses docker-compose.prod.yml, which reads its secrets from mounted files
# rather than from here — see the "Deployment" section at the bottom, and
# docs/operations/deployment-oracle-vm.md.
#
# This file is committed and contains no real values. Placeholders only.

# --- PostgreSQL ---
POSTGRES_USER=careconnect
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_PORT=9092

# --- JWT (identity-service) ---
# Generate locally: openssl rand -base64 64
JWT_SECRET=change-me-generate-a-real-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Gateway trust (all services) ---
# Shared secret the gateway attaches to every request it forwards. Services
# ignore X-User-* identity headers that arrive without it, so a caller who
# reaches a service directly cannot claim to be an admin.
# Generate locally: openssl rand -base64 48
GATEWAY_SHARED_SECRET=change-me-generate-a-real-secret

# --- Initial admin account (identity-service seeds it on first start; leave
# password empty to skip seeding) ---
# The clinic administrator. This account hires doctors and configures the
# clinic — without it the system has no way to create anything, so local dev
# defaults to Admin12345 even if you leave this blank.
SEED_ADMIN_EMAIL=admin@careconnect.local
SEED_ADMIN_PASSWORD=Admin12345


# ===========================================================================
# Deployment (docker-compose.prod.yml + docker-compose.edge.yml)
#
# The four secrets above are NOT set here for a deployment. They are mounted as
# files from SECRETS_DIR, one per value, because environment variables are
# visible to `docker inspect` and to anything that can read /proc. Create them
# with:  ./infra/secrets/generate.sh /opt/careconnect/secrets
#
# What remains below is configuration, not credentials.
# ===========================================================================

# --- Where the images come from ---
# Deploy by immutable commit SHA, never 'latest': a rollback is then re-running
# the pipeline with an older SHA, and the running version is always identifiable.
CARECONNECT_REGISTRY=ghcr.io/your-github-username
CARECONNECT_TAG=latest

# --- Secrets directory (see infra/secrets/generate.sh) ---
SECRETS_DIR=/opt/careconnect/secrets

# --- Public hostname and TLS ---
# The name the certificate is issued for and the SPA is reached at.
CARECONNECT_DOMAIN=careconnect.duckdns.org
# Let's Encrypt uses this only to warn about a renewal it could not complete.
ACME_EMAIL=you@example.com
# Uncomment for the FIRST run against a new hostname. Staging certificates are
# untrusted by browsers but carry none of production's rate limits, and five
# failed production attempts locks the name out for a week.
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# --- CORS ---
# Must include the deployed origin or every POST is rejected with a bare 403
# before it is routed: browsers send Origin on same-origin POST/PUT/DELETE, and
# GETs keep working, which makes this unusually confusing to diagnose.
CORS_ALLOWED_ORIGINS=https://careconnect.duckdns.org

# --- Backups (infra/postgres/backup.sh) ---
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
